# Local environment and secrets
.env
.env.*
!.env.example
/.streamlit/secrets.toml
*.pem
*.p8
*.key
.dlt/

# Local ingestion data and runtime state
/data/

# Python caches and test artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Build and packaging output
build/
dist/
*.egg-info/

# DuckDB files created outside the data directory
*.duckdb
*.duckdb.wal

# Local Python virtual environment
.venv/
# dbt generated artifacts
/dbt/target/
/dbt/logs/
/dbt/dbt_packages/

# Local dbt and Fusion configuration
/.user.yml
/profiles.yml
/dbt/profiles.yml

# Guard against local data created inside the dbt project
/dbt/data/

# Local dbt configuration and generated documentation site
/dbt/.user.yml
/dbt/docs-site/
